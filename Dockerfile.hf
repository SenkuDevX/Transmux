FROM node:22-slim
RUN apt-get update && apt-get install -y ffmpeg python3 python3-pip curl git && rm -rf /var/lib/apt/lists/*
RUN PIP_REQUIRE_VIRTUALENV=false pip3 install --break-system-packages --no-cache-dir yt-dlp "curl_cffi>=0.14,<0.15"
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
RUN npm run build:server
ENV NODE_ENV=production
ENV PORT=7860
ENV CLOUD_MODE=true
EXPOSE 7860
CMD ["node", "dist/server.cjs"]
