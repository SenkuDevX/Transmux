FROM node:22-bookworm

RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-dev \
    libssl-dev \
    pkg-config \
    rustc \
    cargo \
    ffmpeg \
    curl \
    libcurl4-openssl-dev \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir \
    "yt-dlp[default]"

RUN PIP_NO_BINARY=curl_cffi pip3 install --no-cache-dir \
    "curl_cffi>=0.12,<0.13"

ENV PYTHONUNBUFFERED=1

WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY . .
RUN npm run build:server
ENV NODE_ENV=production
ENV PORT=7860
ENV CLOUD_MODE=true
EXPOSE 7860
CMD ["node", "dist/server.cjs"]
