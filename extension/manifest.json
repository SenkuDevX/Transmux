{
  "manifest_version": 3,
  "name": "Transmux — Media Converter & Cookie Relay",
  "version": "5.0",
  "description": "Convert any media, extract audio, create GIFs, auto-sync YouTube cookies, and send media to Transmux from any tab.",
  "permissions": [
    "cookies",
    "storage",
    "contextMenus",
    "tabs",
    "notifications",
    "scripting",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.soundcloud.com/*",
    "https://*.vimeo.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.reddit.com/*",
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Transmux — Convert Media",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
