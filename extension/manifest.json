{
  "manifest_version": 3,
  "name": "Transmux Cookie Relay",
  "version": "1.0",
  "description": "Securely sends YouTube cookies to Transmux when authentication is needed.",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Transmux Cookie Relay",
    "default_icon": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
