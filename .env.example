# ───────── Backend (server) ─────────

# NODE_ENV: "production" for deployment, unset/"development" for local dev
NODE_ENV=development

# PORT: HTTP listen port (default 3000)
PORT=3000

# BACKEND_URL: Public URL of the backend (used for self-referential links)
BACKEND_URL=http://localhost:3000

# CLOUD_MODE: Set to "true" when frontend runs separately on Vercel
# When true, the backend does NOT serve static frontend files
CLOUD_MODE=false

# ───────── S3 / Cloudflare R2 Storage ─────────
# Required for persistent file hosting across server restarts.
# Compatible with any S3 API: Cloudflare R2, AWS S3, MinIO, Backblaze B2

# S3_ENDPOINT: S3-compatible endpoint URL
# Cloudflare R2 example: https://<accountid>.r2.cloudflarestorage.com
# AWS S3 example: https://s3.<region>.amazonaws.com
S3_ENDPOINT=

# S3_REGION: Region (use "auto" for R2, "us-east-1" for AWS, etc.)
S3_REGION=auto

# S3_ACCESS_KEY_ID: S3 API access key
S3_ACCESS_KEY_ID=

# S3_SECRET_ACCESS_KEY: S3 API secret key
S3_SECRET_ACCESS_KEY=

# S3_OUTPUT_BUCKET: Bucket name for storing converted output files
S3_OUTPUT_BUCKET=transmux-files

# S3_PUBLIC_URL: (Optional) Public URL for the bucket (e.g. R2.dev domain or custom domain)
# If set, files are accessible at this URL without signed URLs
S3_PUBLIC_URL=

# ADMIN_KEY: Secret key for admin-only endpoints (e.g. cookie upload).
# Set this on HF Spaces to protect your YouTube cookies from users.
# Use it when calling POST /api/cookies with header: Authorization: Bearer <ADMIN_KEY>
ADMIN_KEY=

# ───────── Auth (Clerk + Supabase + Socket.IO) ─────────

# Clerk: https://clerk.com — Sign up for free, create an app, copy the publishable key
# VITE_CLERK_PUBLISHABLE_KEY: Frontend Clerk publishable key
VITE_CLERK_PUBLISHABLE_KEY=

# CLERK_JWT_VERIFICATION_KEY: Backend Clerk JWT verification key (PEM)
# Get from Clerk Dashboard > API Keys > JWT Verification Key
CLERK_JWT_VERIFICATION_KEY=

# AUTH_ENABLED: Set to "true" to enforce login. When false, anonymous mode is used.
AUTH_ENABLED=false

# Supabase: https://supabase.com — Create a project, copy the anon key and URL
# VITE_SUPABASE_URL: Supabase project URL
VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY: Supabase anon/public key
VITE_SUPABASE_ANON_KEY=

# Socket.IO: For realtime progress updates
# VITE_SOCKET_URL: (Optional) Override Socket.IO server URL (defaults to VITE_API_URL)
VITE_SOCKET_URL=

# ───────── Frontend (Vercel) ─────────

# VITE_API_URL: Backend API URL injected at build time (Vite env prefix)
# Example: https://transmux-api.onrender.com
# Used by the React frontend to reach the backend from Vercel
VITE_API_URL=http://localhost:3000
